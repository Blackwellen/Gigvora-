NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000

# Postgres
DATABASE_URL=postgres://gigvora:gigvora@localhost:5432/gigvora
DB_HOST=localhost
DB_PORT=5432
DB_USER=gigvora
DB_PASSWORD=gigvora
DB_NAME=gigvora
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Auth
JWT_ACCESS_SECRET=change_me_access
JWT_REFRESH_SECRET=change_me_refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Object storage — provider switch: 'r2' (Cloudflare R2) or 's3' (local MinIO)
STORAGE_PROVIDER=r2

# Object storage (S3-compatible / MinIO) — used when STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=gigvora
S3_SECRET_ACCESS_KEY=gigvora123
S3_BUCKET=gigvora-uploads
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_URL=http://localhost:9000/gigvora-uploads

# Cloudflare R2 — used when STORAGE_PROVIDER=r2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=gigvora-uploads
R2_ENDPOINT=
R2_PUBLIC_URL=

# ML service
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_API_KEY=change_me_ml_key

# Azure AI Foundry — messaging AI (smart replies / summaries / safety classification).
# App works fine with these unset (AI features degrade gracefully).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# Deployment names — GUESSED to match "GPT-5.4 nano/mini deployments"; fix as a
# one-line env change if the real deployment names differ.
AZURE_OPENAI_DEPLOYMENT_DEFAULT=gpt-5.4-mini
AZURE_OPENAI_DEPLOYMENT_FAST=gpt-5.4-nano

# LiveKit (self-hosted SFU — infra/docker/docker-compose.dev.yml / livekit.yaml)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Stripe Billing (server-only)
STRIPE_SECRET_KEY=
STRIPE_SECRET_KEY_TEST=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_DESTINATION_ID=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY_TEST=
